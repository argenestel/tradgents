# The deployer refuses unless this is testnet. Use a local Anvil fixture while testing.
MONAD_NETWORK=testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# A file containing only a local/testnet 32-byte private key; never use a mainnet key.
DEPLOYER_KEY_FILE=
# Canonical testnet WMON by default. Pass --wmon for local Anvil's WETH9-like fixture.
# TESTNET_WMON=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
# TESTNET_DEPLOY_OUT=out/testnet.json
