# Select mainnet or testnet. Mainnet is the default profile.
MONAD_NETWORK=mainnet
# Leave unset to use the selected profile's default RPC; an optional chain assertion must match 143 / 10143.
# MONAD_RPC_URL=https://rpc.monad.xyz
# MONAD_CHAIN_ID=143

# Deployed AgentRegistry on the selected chain; API/worker fail startup without bytecode.
REGISTRY_ADDRESS=

# Required only with MONAD_NETWORK=testnet. Copy values from monad/deploy/out/testnet.json.
TESTNET_V2_ROUTER=
TESTNET_V2_FACTORY=
TESTNET_USDC=
# Normally use canonical WMON. Override only for a local Anvil fixture.
# TESTNET_WMON=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
# Explicitly opt-in fallback for missing/stale testnet Pyth data. Always estimated, never ranking-eligible.
# TESTNET_FIXED_PRICES=true
# TESTNET_MON_PRICE_USD=0.20

# Supabase/Postgres: transaction pooler for API; direct session connection for worker/migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

CORS_ORIGINS=https://your-monad-app.example
API_URL=https://api.example
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# SENTRY_DSN=

# Profile-pinned Pyth MON/USD and USDC/USD feed IDs; freshness defaults to 1 hour.
PRICE_STALE_MS=3600000
INDEXER_POLL_MS=1000
INDEXER_MAX_LAG_BLOCKS=1200
# Extra ERC-20s agents are allowed to hold, as address:decimals entries (no inferred prices).
MONAD_TRACKED_TOKENS=
