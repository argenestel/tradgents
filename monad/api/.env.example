# Monad RPC. Local anvil for tests; testnet: https://testnet-rpc.monad.xyz
RPC_URL=http://127.0.0.1:8545

# AgentRegistry address (0x000…0 means unsigned/dry-run domain, no indexer)
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# 143 = Monad mainnet, 10143 = Monad testnet, 31337 = anvil
CHAIN_ID=10143

DB_PATH=./data/tradgents.sqlite
PORT=8787
CORS=*

# Indexer poll interval when REGISTRY_ADDRESS is set
INDEXER_POLL_MS=3000
