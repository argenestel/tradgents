# Mainnet RPC endpoint with eth_chainId, finalized/safe tags, eth_getLogs and receipts.
# Trace support is required for venue calls that may move internal MON; otherwise they are unsupported.
# Public RPC limits may be insufficient for full finalized-block indexing.
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143

# Deployed AgentRegistry address (must have non-empty bytecode on chain 143).
REGISTRY_ADDRESS=

# Supabase/Postgres: transaction pooler for API; direct session connection for worker/migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Comma-separated exact browser origins; empty disables cross-origin access.
CORS_ORIGINS=https://your-monad-app.example
API_URL=https://api.example
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# SENTRY_DSN=

# Official Pyth mainnet feed IDs from https://github.com/monad-crypto/protocols/blob/main/mainnet/pyth.jsonc
MONAD_PRICE_FEED_ID=0x31491744e2dbf6df7fcf4ac0820d18a609b49076d45066d3568424e62f686cd1
USDC_PRICE_FEED_ID=0xeaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a
PRICE_STALE_MS=3600000
INDEXER_POLL_MS=1000
INDEXER_MAX_LAG_BLOCKS=1200
# Extra ERC-20s agents are allowed to hold, as address:decimals entries (no inferred prices).
# Any nonzero balance remains unpriced/ineligible until an oracle is explicitly configured.
MONAD_TRACKED_TOKENS=
