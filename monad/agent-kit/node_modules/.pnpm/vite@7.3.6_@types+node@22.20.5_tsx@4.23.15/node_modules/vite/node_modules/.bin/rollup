#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/arg/projects/hack/tradgents/monad/agent-kit/node_modules/.pnpm/rollup@4.64.0/node_modules/rollup/node_modules:/home/arg/projects/hack/tradgents/monad/agent-kit/node_modules/.pnpm/rollup@4.64.0/node_modules:/home/arg/projects/hack/tradgents/monad/agent-kit/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/arg/projects/hack/tradgents/monad/agent-kit/node_modules/.pnpm/rollup@4.64.0/node_modules/rollup/node_modules:/home/arg/projects/hack/tradgents/monad/agent-kit/node_modules/.pnpm/rollup@4.64.0/node_modules:/home/arg/projects/hack/tradgents/monad/agent-kit/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../rollup/dist/bin/rollup" "$@"
else
  exec node  "$basedir/../../../rollup/dist/bin/rollup" "$@"
fi
