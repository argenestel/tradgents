# Mainnet is the default. For the demo, explicitly select testnet and chain 10143.
MONAD_NETWORK=mainnet
# Optional profile assertion / RPC override; otherwise use the profile defaults.
# MONAD_CHAIN_ID=143
# MONAD_RPC_URL=https://rpc.monad.xyz
REGISTRY_ADDRESS=

# Required only with MONAD_NETWORK=testnet; copy the deployed addresses from monad/deploy/out/testnet.json.
TESTNET_V2_ROUTER=
TESTNET_V2_FACTORY=
TESTNET_USDC=
# TESTNET_WMON is only for local Anvil fixtures; otherwise canonical testnet WMON is pinned.
# TESTNET_WMON=
# Explicit estimated fallback only for testnet if Pyth is missing/stale.
# TESTNET_FIXED_PRICES=true
# TESTNET_MON_PRICE_USD=0.20

SIGNER_DIR=/run/tradgents/signer
SIGNER_POLICY_FILE=/etc/tradgents/signer-policy.json
# Provision a local file out-of-band, owned by the signer and mode 0600. Never put its contents here.
SIGNER_KEY_FILE=/path/to/provisioned/key
TRADGENTS_SIGNER_SOCKET=/run/tradgents/signer/signer.sock
TRADGENTS_SIGNER_SOCKET_MODE=0600
# TRADGENTS_SIGNER_SOCKET_GID=
# MONAD_CHAIN_ID must be 143 on mainnet or 10143 on testnet when set.
