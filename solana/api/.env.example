# --- required
SOLANA_CLUSTER=mainnet-beta
RPC_URL=https://YOUR-MAINNET-RPC            # a paid provider; the public endpoint is not meant for this load
PROGRAM_ID=                                 # the registry program you deployed
# The API's role (tradgents_api, a member of tradgents_read), transaction pooler, port 6543.
DATABASE_URL=postgres://tradgents_api:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# The worker's role (tradgents_worker, a member of tradgents_app), direct connection, port 5432: its single-instance lock needs a session.
DATABASE_URL_DIRECT=postgres://tradgents_worker:PASSWORD@db.PROJECT.supabase.co:5432/postgres
CORS_ORIGINS=https://your-web-origin
# --- optional
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
JUPITER_API_KEY=
MIN_LIQUIDITY_USD=25000
POLL_SECONDS=10
EXTRA_SWAP_PROGRAMS=
# Migrations are run with a separate owner role, never with the app role:
#   DATABASE_URL_DIRECT=postgres://postgres:OWNER_PASSWORD@db.PROJECT.supabase.co:5432/postgres pnpm migrate
